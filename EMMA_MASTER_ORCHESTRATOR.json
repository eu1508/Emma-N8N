    {
      "parameters": {
        "jsCode": "const m = $('PARSE_MAYOR_JSON').first().json;\nconst e = $('EXECUTE_ENGINE').isExecuted ? $('EXECUTE_ENGINE').first().json : null;\nconst esc = s => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n\nlet reply = esc(m.emma_reply || 'Verstanden.');\nif (e) {\n  if (e.summary) reply += `\\n\\n<b>${esc(e.engine)}:</b> ${esc(e.summary)}`;\n  if (e.tasks_created) reply += `\\n📋 ${e.tasks_created} Aufgabe(n) angelegt`;\n  if (e.leads_created) reply += `\\n🎯 ${e.leads_created} Lead(s) gespeichert`;\n  if (e.needs_approval) reply += `\\n⚠️ Hohes Risiko – wartet auf deine Freigabe`;\n}\nif (reply.length > 4000) reply = reply.slice(0, 3990) + '…';\nreturn [{ json: { ...m, engine_result: e, reply } }];"
      },
