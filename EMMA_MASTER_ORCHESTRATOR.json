    {
      "parameters": {
        "jsCode": "const src = $input.first().json;\nconst isTelegram = !!src.message?.chat?.id;\nconst body = isTelegram ? {} : (src.body || src);\nlet channel = 'WEBHOOK';\nif (isTelegram) channel = 'TELEGRAM';\nelse if ($('WHATSAPP_IN').isExecuted) channel = 'WHATSAPP';\nelse if ($('SOCIAL_IN_GENERIC').isExecuted) channel = 'SOCIAL';\nconst prefix = { TELEGRAM: 'TG', WHATSAPP: 'WA', SOCIAL: 'SO', WEBHOOK: 'WB' }[channel];\nreturn [{ json: {\n  text: String(isTelegram ? (src.message.text || src.message.caption || '') : (body.text || body.message || '')),\n  sender: String(isTelegram ? (src.message.from?.username || src.message.from?.id) : (body.sender || 'UNBEKANNT')),\n  channel,\n  chat_id: isTelegram ? src.message.chat.id : null,\n  timestamp: new Date().toISOString(),\n  session_id: `${prefix}_${$execution.id}`,\n} }];"
      },
      "id": "82495370-4c78-5996-8751-f6b771f9dca0",
      "name": "NORMALIZE_OMNI",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        440
      ]
    },
    {
      "parameters": {
        "jsCode": "// FULL-Rechte nur für freigegebene Telegram-Chat-IDs – Benutzernamen sind frei wählbar und daher kein Schutz.\nconst FULL_ACCESS_CHAT_IDS = ['5024797685'];\nconst j = $input.first().json;\nconst exec_mode = j.channel === 'TELEGRAM' && FULL_ACCESS_CHAT_IDS.includes(String(j.chat_id)) ? 'FULL' : 'READONLY';\nreturn [{ json: { ...j, exec_mode } }];"
      },
      "id": "35a206e9-b152-5238-bbf4-ea2e2603c073",
      "name": "EXECUTION_POLICY",
      "type": "n8n-nodes-base.code",
