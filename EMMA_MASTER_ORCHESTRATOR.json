        "functionCode": "const j = $json;\nconst t = (j.text || j.chatInput || j.body?.text || j.message?.text || j.task || '').toLowerCase();\nconst rules = [\n  ['OPS', /ops|operation|health|status|savings|ersparnis|ausfall|uptime|leistung|kpi|monitor/],\n  ['ERROR_GUARDIAN', /error|fehler|incident|störung|alarm|guardian|ausfall/],\n  ['SELF_BUILDER', /self.?builder|workflow bauen|workflow erstellen|n8n workflow|selbstbau/],\n  ['MULTI_AGENT', /multi.?agent|mehrere agenten|strategie risiko chance/],\n  ['GITHUB', /github|git|repo|issue|pull request|pr|commit|code review|branch|deploy/],\n  ['ASANA', /asana|task|aufgabe|projekt|deadline|todo/],\n  ['SHOPIFY', /shopify|shop|produkt|inventory|order|bestellung/],\n  ['WORDPRESS', /wordpress|blog|post|seite|seo|cms/],\n  ['DISCORD', /discord|community|server|channel|social/],\n  ['GOOGLE_SUITE', /google|sheet|doc|calendar|drive|gmail/],\n  ['DRIVE', /drive|datei|ablage|ordner|dokument/],\n  ['EMAIL_VALIDATION', /email|e-mail|mail|deliverability|adresse/],\n  ['BITWARDEN', /bitwarden|vault|passwort|secret|token|credential/],\n  ['GUARDIAN', /risk|risiko|compliance|security|sicherheit|datenschutz/],\n  ['LEGAL', /vertrag|recht|legal|haftung|agb|policy|gesetz/],\n  ['FINANCE', /finance|finanz|steuer|rechnung|roi|kosten|buchhaltung/],\n  ['VENTURE', /venture|business|gründung|startup|dropshipping|monetaris/],\n  ['INTEL', /osint|intel|recherche|analyse|wettbewerb|markt/],\n  ['LEAD', /lead|akquise|prospect|kontakt|kunde gewinnen/],\n  ['SALES', /sales|verkauf|angebot|abschluss|deal/],\n  ['CONTENT', /content|text|post|copy|newsletter|headline/],\n  ['PRICING', /preis|pricing|paket|marge/],\n  ['QUICKCHART', /chart|diagramm|grafik|visualisierung/],\n  ['REACTIVATION', /reaktiv|winback|follow.?up/],\n  ['SPOTIFY', /spotify|playlist|musik|song/],\n  ['STREAMS', /stream|live|twitch|youtube live/],\n  ['EVOLUTION', /optimier|evolution|verbesser|self.?improve/],\n  ['VECTOR_MEMORY', /vector|memory|gedächtnis|embedding|kontext/],\n  ['LOGGING', /log|logging|audit|protokoll/],\n  ['KPI', /kpi|metrik|kennzahl|dashboard/],\n  ['SYNC', /sync|synchron|registry|abgleich/],\n  ['SUPERNOVA', /supernova|durchbruch|vision|strategie|2046/]\n];\nlet engine = 'CONTENT';\nfor (const [candidate, rx] of rules) { if (rx.test(t)) { engine = candidate; break; } }\nreturn [{ json: { ...j, engine, llm_routing: { best_model: 'GEMINI_2_5_FLASH', capability: engine } } }];"
