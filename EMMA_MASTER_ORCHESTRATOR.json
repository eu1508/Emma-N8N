        {
            "parameters": {
                "functionCode": "const src = $json;\nconst isTelegram = !!src.message?.chat?.id;\nreturn [{\n  json: {\n    text: isTelegram ? src.message.text : (src.text || src.body || src.message || ''),\n    sender: isTelegram ? (src.message.from?.username || src.message.from?.id) : (src.sender || 'UNBEKANNT'),\n    channel: isTelegram ? 'TELEGRAM' : 'WEBHOOK',\n    chat_id: isTelegram ? src.message.chat.id : null,\n    meta: src,\n    timestamp: new Date().toISOString(),\n    session_id: `${isTelegram ? 'TG' : 'WB'}_${Date.now()}`\n  }\n}];"
            },
            "id": "normalize-omni",
            "name": "NORMALIZE_OMNI",
            "type": "n8n-nodes-base.function",
            "typeVersion": 1,
            "position": [
                -1696,
                560
            ]
        },
        {
            "parameters": {
                "functionCode": "const j = $json;\nconst sender = (j.sender || '').toLowerCase();\nlet exec_mode = 'READONLY';\nconst masterKeys = ['irina', 'ceo', 'master', 'worldmaster', 'au_bs'];\nif (masterKeys.some(k => sender.includes(k))) exec_mode = 'FULL';\nif (j.meta?.source === 'LOCAL_PC') exec_mode = 'FULL';\nreturn [{ json: { ...j, exec_mode } }];"
            },
            "id": "execution-policy",
            "name": "EXECUTION_POLICY",
            "type": "n8n-nodes-base.function",
            "typeVersion": 1,
            "position": [
                -1488,
