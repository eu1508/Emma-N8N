    {
      "parameters": {
        "promptType": "define",
        "text": "=Du bist THE MAYOR (v14.0) von EMMA METROPOLIS.\n\nZEIT: 2046. STATUS: Sovereign OS. PERSONA: CEO.\nEINGANG: {{ $json.text }}\n\nHandle als Meta-Cortex. Entscheide, ob eine Fach-Engine gebraucht wird.\nFür Begrüßungen, Smalltalk und einfache Fragen: engine = \"NONE\" und direkt antworten.\n\nAntworte NUR als JSON:\n{\n  \"engine\": \"SUPERNOVA|FINANCE|LEGAL|INTEL|VENTURE|LEAD|SALES|REACTIVATION|PRICING|CONTENT|SOCIAL|WORDPRESS|SHOPIFY|GITHUB|TASKS|GOOGLE_SUITE|GUARDIAN|EMAIL_VALIDATION|CHART|MEDIA|EVOLUTION|GENERAL|NONE\",\n  \"intent_2046\": \"Visionäre Einordnung\",\n  \"emma_reply\": \"Antwort an Irina\",\n  \"needs_local_action\": false\n}"
      },
      "id": "dbbf7e3a-5c7e-5e9c-b1ed-ba279674bcbc",
      "name": "THE_MAYOR_BRAIN",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.4,
      "position": [
        760,
        480
      ]
    },
    {
      "parameters": {
        "modelName": "models/gemini-2.5-flash",
        "options": {
          "temperature": 0.5
        }
      },
      "id": "d00c7cee-ad62-5f1b-a19b-389dca105238",
      "name": "The Mayor Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        760,
        680
      ],
      "credentials": {
        "googlePalmApi": {
          "id": "U6jVg3cxRNRwbqPQ",
          "name": "Google Gemini API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const ENGINES = [\"SUPERNOVA\", \"FINANCE\", \"LEGAL\", \"INTEL\", \"VENTURE\", \"LEAD\", \"SALES\", \"REACTIVATION\", \"PRICING\", \"CONTENT\", \"SOCIAL\", \"WORDPRESS\", \"SHOPIFY\", \"GITHUB\", \"TASKS\", \"GOOGLE_SUITE\", \"GUARDIAN\", \"EMAIL_VALIDATION\", \"CHART\", \"MEDIA\", \"EVOLUTION\", \"GENERAL\"];\nconst response = $input.first().json.text || '';\nlet base = {};\nconst m = response.match(/\\{[\\s\\S]*\\}/);\nif (m) { try { base = JSON.parse(m[0]); } catch (e) {} }\nconst engine = String(base.engine || '').toUpperCase();\nreturn [{ json: {\n  ...$('EXECUTION_POLICY').first().json,\n  engine: ENGINES.includes(engine) ? engine : 'NONE',\n  emma_reply: base.emma_reply || (m ? '' : response),\n  intent_2046: base.intent_2046 || '',\n} }];"
      },
