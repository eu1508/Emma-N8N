      "parameters": {
        "functionCode": "const src = $json;\nconst isTelegram = !!src.message?.chat?.id;\nreturn [{\n  json: {\n    text: isTelegram ? src.message.text : (src.text || src.body?.text || src.body || src.message?.text || src.message || ''),\n    original_input: isTelegram ? src.message.text : (src.text || src.body?.text || src.body || src.message?.text || src.message || ''),\n    sender: isTelegram ? (src.message.from?.username || src.message.from?.id) : (src.sender || 'UNBEKANNT'),\n    channel: isTelegram ? 'TELEGRAM' : 'WEBHOOK',\n    chat_id: isTelegram ? src.message.chat.id : null,\n    meta: src,\n    timestamp: new Date().toISOString(),\n    session_id: `${isTelegram ? 'TG' : 'WB'}_${Date.now()}`\n  }\n}];"
      },
