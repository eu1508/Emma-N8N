    {
      "parameters": {
        "jsCode": "// Einstellungen kommen aus Umgebungsvariablen des n8n-Containers – nie Werte ins Repo schreiben.\nconst env = k => { try { return $env[k]; } catch (e) { return undefined; } };\nconst cfg = {\n  core_os_url: String(env('EMMA_CORE_OS_URL') || '').replace(/\\/$/, ''),\n  budget_eur: Number(env('EMMA_BUDGET_EUR') || 5),\n  daily_docs: String(env('EMMA_DAILY_DOCS') || 'on') !== 'off',\n};\nreturn [{ json: cfg }];"
      },
      "id": "ce926b1f-e3ae-5fb0-8e7a-cd90fa6bef92",
      "name": "Konfiguration",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        200,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "const b = $('AGENT_IN').first().json.body || {};\nreturn [{ json: { text: String(b.text || b.message || '').slice(0, 4000) } }];"
      },
      "id": "4a69b3a3-267f-5c05-b0a1-f9557cecbdcf",
      "name": "Prepare",
