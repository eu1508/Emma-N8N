    {
      "parameters": {
        "jsCode": "const b = $('Webhook Input').first().json.body || {};\nconst task = String(b.task || b.message || '').trim().slice(0, 2000);\nif (!task) throw new Error('Feld \"task\" fehlt');\nreturn [{ json: { task, task_key: task.toLowerCase().replace(/\\s+/g, ' ') } }];"
      },
      "id": "f64e2af8-656f-52cb-8c06-4d963ac761b0",
      "name": "Normalize Input",
