      ],
      "credentials": {
        "postgres": {
          "id": "q2sycFRoxqP47oRY",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const w = $('Parse Workflow').first().json;\nreturn [{ json: { kind: 'create_workflow', summary: `Neuen Workflow ${w.workflow_name} anlegen (inaktiv)`, source: 'self_builder',\n  payload: { workflow_name: w.workflow_name, workflow_json: w.workflow_json } } }];"
      },
