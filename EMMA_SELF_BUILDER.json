    {
      "parameters": {
        "jsCode": "const b = $input.first().json.body || {};\nconst task = String(b.task || b.message || '').trim();\nif (!task) throw new Error('Feld \"task\" fehlt');\nreturn [{ json: {\n  user: b.user || 'Irina', task,\n  task_key: task.toLowerCase().replace(/\\s+/g, ' '),\n  session_id: b.session_id || $execution.id,\n  timestamp: new Date().toISOString(),\n} }];"
      },
      "id": "f64e2af8-656f-52cb-8c06-4d963ac761b0",
      "name": "Normalize Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        400
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT workflow_name FROM workflow_registry WHERE lower(regexp_replace(purpose, '\\s+', ' ', 'g')) = $1 ORDER BY created_at DESC LIMIT 1;",
        "options": {
          "queryReplacement": "={{ [ $json.task_key ] }}"
        }
      },
      "id": "ebddcc03-a89c-5ba9-8e60-36b61e366f6d",
      "name": "Find Existing",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        440,
        400
      ],
      "credentials": {
        "postgres": {
          "id": "q2sycFRoxqP47oRY",
          "name": "Postgres account"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "45886a0d-e8ae-59e5-a952-e7bec19d81a5",
              "leftValue": "={{ $json.workflow_name }}",
              "operator": {
                "type": "string",
                "operation": "exists"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
