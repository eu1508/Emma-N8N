        "respondWith": "json",
        "responseBody": "={{ { success: true, duplicate: true, workflow_name: $json.workflow_name, message: 'Dieser Workflow existiert bereits – es wurde kein neuer angelegt.' } }}",
        "options": {}
      },
      "id": "43e33ceb-f81f-5b1c-a0b9-3f22e50d90e6",
      "name": "Respond Existing",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        880,
        260
      ]
    },
    {
      "parameters": {
        "jsCode": "return [{ json: $('Normalize Input').first().json }];"
      },
      "id": "86dd604c-9649-5372-be4f-9423f9b65d3f",
      "name": "Restore Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        520
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Du bist EMMA's strategische Workflow-Architektin.\n\nDeine Mission: Entwirf die kognitive Struktur für einen neuen Workflow.\n\nAnfrage: {{ $json.task }}\n\nAntworte als technischer Entwurf (JSON):\n{\n  \"workflow_type\": \"CONTENT|AUTOMATION|INTEGRATION|ORCHESTRATION|CUSTOM\",\n  \"complexity\": 1-10,\n  \"cognitive_requirement\": \"Was muss die KI hier 'verstehen'?\",\n  \"required_nodes\": [\"node1\", \"node2\"],\n  \"logic_gate\": \"Wie wird der Erfolg gemessen?\"\n}"
      },
      "id": "492f0f68-f4bf-5598-94b4-0f5717d6fbcb",
      "name": "Analyze Task",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.4,
      "position": [
        1100,
        520
      ]
    },
    {
      "parameters": {
        "modelName": "models/gemini-2.5-flash",
        "options": {
          "temperature": 0.3
        }
      },
      "id": "42f5a11b-217f-53c2-84de-bb48202074e3",
      "name": "Gemini Analyze Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        1100,
        720
      ],
      "credentials": {
        "googlePalmApi": {
          "id": "U6jVg3cxRNRwbqPQ",
          "name": "Google Gemini API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json.text || '{}';\nlet analysis;\ntry {\n  const m = response.match(/\\{[\\s\\S]*\\}/);\n  analysis = m ? JSON.parse(m[0]) : {};\n} catch (e) {\n  analysis = { workflow_type: 'CUSTOM', complexity: 5 };\n}\nreturn [{ json: { ...$('Normalize Input').first().json, analysis } }];"
      },
      "id": "c82e1ed2-f3ec-5a57-b499-cc1364587b02",
      "name": "Parse Analysis",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        520
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Du bist EMMA's Workflow-Generator (Cognitive Version).\n\nErstelle ein n8n JSON, das für Irina's Erfolg optimiert ist.\n\nAnforderungen:\n- Task: {{ $json.task }}\n- Typ: {{ $json.analysis.workflow_type }}\n- Komplexität: {{ $json.analysis.complexity }}\n\nFormat: Valides n8n JSON mit \"nodes\" und \"connections\". Verbindungen referenzieren Node-NAMEN, nicht IDs.\n\nAntworte NUR mit dem JSON-Objekt."
      },
      "id": "e0fd10d0-a632-547b-b527-cb07759fccbd",
      "name": "Generate Workflow",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.4,
      "position": [
        1540,
        520
      ]
    },
    {
      "parameters": {
        "modelName": "models/gemini-2.5-flash",
        "options": {
          "temperature": 0.2
        }
      },
      "id": "aab83ca9-a335-51eb-8ae3-0e985257e5fb",
      "name": "Gemini Generate Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        1540,
        720
      ],
      "credentials": {
        "googlePalmApi": {
          "id": "U6jVg3cxRNRwbqPQ",
          "name": "Google Gemini API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const req = $('Parse Analysis').first().json;\nconst response = $input.first().json.text || '{}';\nconst m = response.match(/\\{[\\s\\S]*\\}/);\nif (!m) throw new Error('Kein JSON vom Generator');\nconst wf = JSON.parse(m[0]);\nif (!Array.isArray(wf.nodes) || !wf.nodes.length) throw new Error('Generierter Workflow hat keine Nodes');\n\n// Kaputte Verbindungen (auf nicht existierende Nodes) sofort ablehnen statt einen toten Workflow anzulegen.\nconst names = new Set(wf.nodes.map(n => n.name));\nfor (const [from, kinds] of Object.entries(wf.connections || {})) {\n  const targets = Object.values(kinds).flat(2).map(c => c?.node);\n  for (const t of [from, ...targets]) if (t && !names.has(t)) throw new Error(`Verbindung auf unbekannten Node: ${t}`);\n}\n\nconst slug = req.task_key.replace(/[^a-z0-9]+/g, '_').replace(/^_|_$/g, '').slice(0, 40).toUpperCase();\nreturn [{ json: {\n  workflow_name: `EMMA_AUTO_${slug || Date.now()}`,\n  workflow_json: { nodes: wf.nodes, connections: wf.connections || {} },\n  task: req.task,\n  timestamp: req.timestamp,\n} }];"
      },
      "id": "ef314001-3a6b-5ad7-a41e-d88a36f9627a",
      "name": "Parse Workflow",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        520
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO workflow_registry (workflow_id, workflow_name, workflow_json, purpose, created_by) VALUES ($1, $1, $2::jsonb, $3, 'EMMA_SELF_BUILDER');",
        "options": {
          "queryReplacement": "={{ [ $json.workflow_name, JSON.stringify($json.workflow_json), $json.task ] }}"
        }
      },
      "id": "7c95f3b3-7707-5198-9ea2-274f58470bb6",
      "name": "Save to Database",
