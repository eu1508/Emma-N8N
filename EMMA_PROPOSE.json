{
  "name": "EMMA_PROPOSE",
  "nodes": [
    {
      "parameters": {
        "inputSource": "passthrough"
      },
      "id": "69d5d920-7468-5458-b8cc-424c7153c28b",
      "name": "Vorschlag",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Einstellungen kommen aus Umgebungsvariablen des n8n-Containers – nie Werte ins Repo schreiben.\nconst env = k => { try { return $env[k]; } catch (e) { return undefined; } };\nconst cfg = {\n  core_os_url: String(env('EMMA_CORE_OS_URL') || '').replace(/\\/$/, ''),\n  budget_eur: Number(env('EMMA_BUDGET_EUR') || 5),\n  daily_docs: String(env('EMMA_DAILY_DOCS') || 'on') !== 'off',\n};\nif (!cfg.core_os_url) throw new Error('EMMA_CORE_OS_URL ist nicht gesetzt – ohne core-os arbeitet EMMA nicht.');\nreturn [{ json: cfg }];"
      },
      "id": "ce926b1f-e3ae-5fb0-8e7a-cd90fa6bef92",
      "name": "Konfiguration",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Nur bekannte Arten; alles andere wird verworfen. Ausgeführt wird erst nach Freigabe in core-os.\nconst KINDS = [\"run_engine\", \"write_note\", \"write_draft\", \"calendar_event\", \"create_workflow\"];\nreturn $('Vorschlag').all().map(i => i.json)\n  .filter(p => KINDS.includes(p.kind) && p.summary)\n  .map(p => ({ json: { kind: p.kind, summary: String(p.summary).slice(0, 300), payload: p.payload || {}, source: String(p.source || 'n8n') } }));"
      },
      "id": "a25c3ee8-2aee-5616-8c79-f3a813c21bca",
      "name": "Vorschläge prüfen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO n8n_action_queue (kind, summary, payload, source) VALUES ($1, $2, $3::jsonb, $4) RETURNING id, kind, summary, source;",
        "options": {
          "queryReplacement": "={{ [ $json.kind, $json.summary, JSON.stringify($json.payload), $json.source ] }}"
        }
      },
      "id": "9c29b36d-ade7-5ee3-b5c5-013737d867ac",
      "name": "In Warteschlange",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        660,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "q2sycFRoxqP47oRY",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Konfiguration').first().json.core_os_url + '/api/v1/approvals' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ source: 'n8n', reference: 'n8n_action_queue:' + $json.id, kind: $json.kind, summary: $json.summary }) }}"
      },
      "id": "9bfbc124-9924-544f-9132-9baf105f4565",
      "name": "Freigabe in core-os anfragen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "CORE_OS_API",
          "name": "core-os API"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE n8n_action_queue SET core_os_approval_id = $2 WHERE id = $1 RETURNING id AS queue_id, core_os_approval_id AS approval_id, kind, summary;",
        "options": {
          "queryReplacement": "={{ [ $('In Warteschlange').item.json.id, String($json.id) ] }}"
        }
      },
      "id": "f9b864ff-607c-5549-abdf-3a7455a672d5",
      "name": "Freigabe-ID speichern",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
