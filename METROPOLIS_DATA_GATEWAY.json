    {
      "parameters": {
        "jsCode": "const b = $input.first().json.body || {};\nlet kind = 'event', source = 'LOG';\nif ($('KPI_IN').isExecuted) kind = 'kpi';\nelse if ($('CRM_IN').isExecuted) kind = 'lead';\nelse if ($('SYNC_IN').isExecuted) source = 'SYNC';\nreturn [{ json: {\n  kind, source,\n  level: String(b.level || b.status || 'INFO').toUpperCase(),\n  message: String(b.message || b.text || (source === 'SYNC' ? 'METROPOLIS_STATUS ACTIVE' : '')),\n  payload: b,\n} }];"
      },
      "id": "fca10488-b604-5b27-8fba-3f415c49aafb",
      "name": "Classify",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        440
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "loose"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{ $json.kind }}",
                    "rightValue": "kpi",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "kpi"
            },
            {
