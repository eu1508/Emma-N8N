    {
      "parameters": {
        "jsCode": "// Einstellungen kommen aus Umgebungsvariablen des n8n-Containers – nie Werte ins Repo schreiben.\nconst env = k => { try { return $env[k]; } catch (e) { return undefined; } };\nconst cfg = {\n  core_os_url: String(env('EMMA_CORE_OS_URL') || '').replace(/\\/$/, ''),\n  budget_eur: Number(env('EMMA_BUDGET_EUR') || 5),\n  daily_docs: String(env('EMMA_DAILY_DOCS') || 'on') !== 'off',\n  n8n_url: String(env('EMMA_N8N_URL') || 'http://localhost:5678').replace(/\\/$/, ''), // interne n8n-API fuer freigegebene Workflows\n  calendar_id: String(env('EMMA_CALENDAR_ID') || ''),\n  drive_notes: String(env('EMMA_DRIVE_FOLDER_NOTES') || ''),\n  drive_drafts: String(env('EMMA_DRIVE_FOLDER_DRAFTS') || ''),\n};\nif (!cfg.core_os_url) throw new Error('EMMA_CORE_OS_URL ist nicht gesetzt – ohne core-os arbeitet EMMA nicht.');\nreturn [{ json: cfg }];"
      },
