    {
      "parameters": {
        "jsCode": "// Jede Aktion meldet Erfolg oder Fehler – nichts wird ungeprüft als erledigt verbucht.\nconst out = $input.all().map((item, idx) => {\n  const r = item.json;\n  const q = $('Offene Vorschläge').itemMatching(idx)?.json || {};\n  const ok = !r.error && r.status !== 'budget_exceeded' && r.status !== 'parse_error';\n  let url = '';\n  if (q.kind === 'write_note' || q.kind === 'write_draft') url = r.id ? 'https://docs.google.com/document/d/' + r.id : '';\n  if (q.kind === 'calendar_event') url = r.htmlLink || '';\n  return { json: {\n    queue_id: q.id, approval_id: q.core_os_approval_id, kind: q.kind, ok,\n    url, title: r.name || r.summary || q.payload?.title || q.payload?.workflow_name || q.kind,\n    detail: ok ? (r.summary || r.name || r.id || 'ok') : String(r.error?.message || r.error || r.status || 'Fehler'),\n  } };\n});\nreturn out;"
      },
      "id": "9b695878-fc02-58a2-a7c5-9f53e42bdcc3",
      "name": "Ergebnis sammeln",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1800,
        400
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH upd AS (\n  UPDATE n8n_action_queue SET status = CASE WHEN $2 THEN 'done' ELSE 'failed' END, result = $3, finished_at = now()\n  WHERE id = $1\n), art AS (\n  INSERT INTO emma_artifacts (kind, title, url) SELECT $4, $5, $6 WHERE $2 AND $6 <> ''\n), reg AS (\n  UPDATE workflow_registry SET status = CASE WHEN $2 THEN 'created_inactive' ELSE 'failed' END\n  WHERE $4 = 'create_workflow' AND workflow_name = $5\n)\nSELECT $1::bigint AS queue_id;",
        "options": {
          "queryReplacement": "={{ [ $json.queue_id, $json.ok, $json.detail, $json.kind === 'write_note' ? 'wissen' : $json.kind === 'write_draft' ? 'entwurf' : $json.kind === 'calendar_event' ? 'kalender' : $json.kind, $json.title, $json.url ] }}"
        }
      },
