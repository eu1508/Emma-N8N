    {
      "parameters": {
        "jsCode": "// Allowlist: kein Code, kein Execute Command, kein beliebiger HTTP-Request, keine Webhooks. (Dieselbe Pruefung laeuft vor dem Anlegen erneut im EMMA_APPROVED_EXECUTOR.)\nconst ALLOWED = new Set([\"n8n-nodes-base.manualTrigger\", \"n8n-nodes-base.scheduleTrigger\", \"n8n-nodes-base.executeWorkflowTrigger\", \"n8n-nodes-base.set\", \"n8n-nodes-base.if\", \"n8n-nodes-base.switch\", \"n8n-nodes-base.merge\", \"n8n-nodes-base.noOp\", \"n8n-nodes-base.filter\", \"n8n-nodes-base.sort\", \"n8n-nodes-base.limit\", \"n8n-nodes-base.dateTime\", \"n8n-nodes-base.googleSheets\", \"n8n-nodes-base.googleCalendar\", \"n8n-nodes-base.googleDrive\", \"@n8n/n8n-nodes-langchain.chainLlm\", \"@n8n/n8n-nodes-langchain.lmChatGoogleGemini\"]);\nconst MAX_NODES = 25, MAX_BYTES = 60000;\nconst FORBIDDEN = /\\$env|\\$vars|\\$secrets|\\$execution|process\\.|require\\s*\\(|import\\s*\\(|child_process|__proto__|constructor|eval\\s*\\(|Function\\s*\\(/i;\nconst checkWorkflow = wf => {\n  if (!wf || typeof wf !== 'object' || !Array.isArray(wf.nodes) || !wf.nodes.length) return { error: 'Workflow ohne Nodes' };\n  if (wf.nodes.length > MAX_NODES) return { error: `Zu viele Nodes (max. ${MAX_NODES})` };\n  if (JSON.stringify(wf).length > MAX_BYTES) return { error: 'Workflow zu gross' };\n  const names = new Set();\n  for (const n of wf.nodes) {\n    if (!n || typeof n.name !== 'string' || !n.name) return { error: 'Node ohne Namen' };\n    if (names.has(n.name)) return { error: `Doppelter Node-Name: ${n.name}` };\n    names.add(n.name);\n    if (!ALLOWED.has(n.type)) return { error: `Nicht erlaubter Node-Typ: ${n.name} (${n.type})` };\n    if (FORBIDDEN.test(JSON.stringify(n.parameters || {}))) return { error: `Node ${n.name}: Zugriff auf Umgebung oder Code nicht erlaubt` };\n  }\n  const connections = wf.connections && typeof wf.connections === 'object' ? wf.connections : {};\n  for (const [from, kinds] of Object.entries(connections)) {\n    for (const t of [from, ...Object.values(kinds).flat(2).map(c => c && c.node)]) if (t && !names.has(t)) return { error: `Verbindung auf unbekannten Node: ${t}` };\n  }\n  // Zugangsdaten und Webhook-IDs entfernen: der Nutzer verknuepft sie selbst, bevor er den Workflow aktiviert.\n  const nodes = wf.nodes.map(({ credentials, webhookId, ...rest }) => rest);\n  return { workflow: { nodes, connections } };\n};\n// Ausgefuehrt wird nur, was die Allowlist auch JETZT noch besteht - egal, was in der Warteschlange steht.\nreturn $input.all().map((i, idx) => {\n  const q = i.json;\n  const name = String((q.payload || {}).workflow_name || '');\n  const checked = /^EMMA_AUTO_[A-Z0-9_]{1,60}$/.test(name) ? checkWorkflow((q.payload || {}).workflow_json) : { error: 'Ungueltiger Workflow-Name' };\n  return { json: { ...q, valid: !checked.error, reject_reason: checked.error || '', workflow_name: name, workflow_json: checked.workflow || null }, pairedItem: { item: idx } };\n});"
      },
