      "id": "09225823-3b6a-5a3a-a7cf-25d5131bc5b6",
      "name": "Workflow anlegen (inaktiv)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1760,
        620
      ],
      "credentials": {
