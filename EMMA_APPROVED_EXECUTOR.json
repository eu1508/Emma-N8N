    {
      "parameters": {
        "jsCode": "// Einstellungen kommen aus Umgebungsvariablen des n8n-Containers – nie Werte ins Repo schreiben.\nconst env = k => { try { return $env[k]; } catch (e) { return undefined; } };\nconst cfg = {\n  core_os_url: String(env('EMMA_CORE_OS_URL') || '').replace(/\\/$/, ''),\n  budget_eur: Number(env('EMMA_BUDGET_EUR') || 5),\n  daily_docs: String(env('EMMA_DAILY_DOCS') || 'on') !== 'off',\n};\nif (!cfg.core_os_url) throw new Error('EMMA_CORE_OS_URL ist nicht gesetzt – ohne core-os arbeitet EMMA nicht.');\nreturn [{ json: cfg }];"
      },
