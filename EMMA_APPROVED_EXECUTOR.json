    {
      "parameters": {
        "jsCode": "// core-os ist die Wahrheit: nur was dort AUSDRUECKLICH freigegeben ist, wird ausgefuehrt (fail-closed).\n// Ignoriert core-os die Filter der Abfrage, zaehlt trotzdem nur, was selbst den Status \"approved\" traegt.\nconst body = $input.first().json;\nconst list = Array.isArray(body) ? body : (body.approvals || body.items || body.data);\nif (!Array.isArray(list)) throw new Error('Antwort von core-os auf die Freigabe-Abfrage ist keine Liste - nichts wird ausgefuehrt.');\nconst approved = a => a && /^(approved|freigegeben)$/i.test(String(a.decision_status ?? a.status ?? '')) && (a.source === undefined || a.source === 'n8n');\nreturn [{ json: { ids: list.filter(approved).map(a => String(a.id)).filter(Boolean) } }];"
      },
