      "id": "194ea138-ec21-5712-a9e9-3eb3c6b5d570",
      "name": "Ergebnis an core-os",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2240,
        400
      ],
      "credentials": {
