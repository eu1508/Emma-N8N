# LITELLM Related Parameters (can be chosen freely, strong passwords/salt keys recommended)
LITELLM_SALT_KEY=your_litellm_salt_key_here
LITELLM_MASTER_KEY=your_litellm_master_key_here
LITELLM_DB_PASSWORD=your_litellm_db_password_here

# GOOGLE API Parameters
GEMINI_API_BASE="https://generativelanguage.googleapis.com/v1beta"
GEMINI_API_KEY=your_gemini_api_key_here

# GROQ API Parameters
GROQ_API_BASE="https://api.groq.com/openai/v1"
GROQ_API_KEY=your_groq_api_key_here

# Passwort der FreeLLM-Datenbank (wird von scripts/install.sh automatisch gesetzt)
FREELLM_DB_PASSWORD=your_freellm_db_password_here

# Ports nur lokal erreichbar (127.0.0.1). Für Zugriff aus dem LAN/von n8n auf
# einem anderen Rechner: HOST_BIND=0.0.0.0 (nur in vertrauenswürdigen Netzen!)
# HOST_BIND=127.0.0.1
