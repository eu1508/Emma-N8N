# Verschlüsselungsschlüssel für gespeicherte API-Keys (64 Hex-Zeichen).
# Wird von scripts/install.sh automatisch erzeugt. Niemals committen!
ENCRYPTION_KEY=your-64-char-hex-key-here

# Port des Servers (Dashboard + API): http://localhost:3001
PORT=3001

# Nur lokal erreichbar. Für Zugriff von anderen Geräten / n8n auf anderem Host:
# HOST_BIND=0.0.0.0   (nur in vertrauenswürdigen Netzen!)
# HOST_BIND=127.0.0.1

# Optional: Anbieter-Keys und Admin-Konto beim Start automatisch einspielen,
# statt sie im Dashboard einzutragen (Format siehe Upstream-.env.example):
# FREEAPI_CONFIG_JSON={"admin":{"email":"you@example.com","password":"change-me"},"keys":[{"platform":"groq","key":"gsk_...","label":"main"}]}

REQUEST_ANALYTICS_RETENTION_DAYS=90
REQUEST_ANALYTICS_MAX_ROWS=100000
