{
  "name": "METROPOLIS_KPI_REGISTRY",
  "nodes": [
    {
      "parameters": {
        "path": "metropolis-kpi",
        "method": "POST",
        "options": {}
      },
      "id": "kpi-in",
      "name": "KPI_IN",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        200,
        400
      ]
    },
    {
      "parameters": {
        "workflowInputs": {
          "values": [
            {
              "name": "text",
              "type": "string"
            },
            {
              "name": "engine",
              "type": "string"
            },
            {
              "name": "source",
              "type": "string"
            }
          ]
        }
      },
      "id": "execute-input",
      "name": "Execute Input",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [
        200,
        180
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=INSERT INTO kpi_metrics (metric_name, value, unit) VALUES ('{{$json.metric}}', '{{$json.value}}', '{{$json.unit || 'count'}}');",
        "options": {}
      },
      "id": "update-kpi",
      "name": "Update KPI SQLite",
      "type": "n8n-nodes-base.sqlite",
      "typeVersion": 1,
      "position": [
        450,
        400
      ],
      "credentials": {
        "sqlite": {
          "id": "local_sqlite_metropolis",
          "name": "Metropolis SQLite"
        }
      }
    }
  ],
  "connections": {
    "KPI_IN": {
      "main": [
        [
          {
            "node": "Update KPI SQLite",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Execute Input": {
      "main": [
        [
          {
            "node": "Update KPI SQLite",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "emma-repaired-2026-05-15"
}
